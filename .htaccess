# ==========================================================================
# Maxilimpo — configuração do alojamento (Apache / LiteSpeed · Hostinger)
# ==========================================================================

# ---------- Documento inicial ----------
DirectoryIndex index.html

# ---------- Não servir os ficheiros de trabalho ----------
# A pasta docs/ tem o briefing, a copy e os logótipos originais: fica versionada
# no Git, mas não deve ser acessível pelo site.
RedirectMatch 404 ^/docs(/|$)
<FilesMatch "\.(md|txt|py|log)$">
  Require all denied
</FilesMatch>
# exceção: o robots.txt tem mesmo de ser público
<Files "robots.txt">
  Require all granted
</Files>

# ---------- HTTPS ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Um só endereço: sem www.
  # (se preferir o site em www., troque este bloco pelo inverso)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Sem barra final nos caminhos
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]
</IfModule>

# ---------- Compressão ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Cache ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # o HTML muda a cada publicação
  ExpiresByType text/html                 "access plus 0 seconds"
  # imagens, fontes e ícones
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  # CSS e JS: 1 semana (acrescente ?v= ao link quando publicar alterações)
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Segurança básica
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# ---------- Tipos MIME (caso o servidor não os conheça) ----------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# ---------- Listagem de pastas desligada ----------
Options -Indexes
